{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devashridatta-dotcom/srac-in-toto-attestation/schema/safety-evidence-graph-v0.1",
  "title": "SRAC decision and evidence closure graph demonstrator",
  "type": "object",
  "required": ["schema", "analysisRoot", "triggers", "decisions", "evidence", "verification", "closure"],
  "properties": {
    "schema": { "const": "https://github.com/devashridatta-dotcom/srac-in-toto-attestation/schema/safety-evidence-graph-v0.1" },
    "analysisRoot": {
      "type": "object",
      "required": ["id", "subject", "triggerId", "evaluatedElements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "triggerId": { "type": "string", "minLength": 1 },
        "evaluatedElements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "triggers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trigger" } },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
    "closure": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "enum": ["open", "inProgress", "complete", "incomplete"] } },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "required": ["sha256"],
      "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "uri": { "type": "string" }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "type", "status", "appliesTo"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["approve", "approveConditionally", "reject", "noAction", "delegate"] },
        "status": { "enum": ["proposed", "recorded", "accepted", "superseded"] },
        "appliesTo": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiredEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requiredVerification": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "digest", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "provenance": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["id", "evidenceId", "result"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "inconclusive"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
